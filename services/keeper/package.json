{
  "name": "keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swarm VolumeRegistry keeper — one Cloudflare Worker per registry deployment",
  "scripts": {
    "dev": "wrangler dev --env sepolia-v2-rc3",
    "check:deploy": "wrangler deploy --dry-run --env sepolia-v2-rc3 --outdir dist/sepolia-v2-rc3",
    "types": "wrangler types --strict-vars false",
    "check:types": "wrangler types --strict-vars false --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "2.55.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.134.0"
  },
  "packageManager": "pnpm@12.9.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    }
  }
}
