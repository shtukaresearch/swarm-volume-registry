{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    // Runtime and Env types come from worker-configuration.d.ts (generated by
    // `pnpm types`, checked in CI by `pnpm check:types`). Node's types are
    // for the tests (Vitest), scripts/aws.ts and the Lambda adapter, which all
    // run on Node 24 against the same source.
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // scripts/ runs on Node's own type stripping, which loads `.ts` paths as
    // written; src/ is bundled, and keeps its `.js` ones.
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
