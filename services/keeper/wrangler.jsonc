{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Each env below is one registry deployment, keyed by its deployment label
  // (`<network>-<release>`, as in contracts/deployments/), and deploys as its own
  // Worker named `keeper-cloudflare-<label>`. Top level is not a deployment: it
  // holds only what the envs share.
  //
  // One Worker per registry deployment, never repointed: a new deployment
  // replaces its predecessor's env here, and the predecessor's Worker keeps
  // running whatever it was last deployed with until it is deleted out of band.
  // Workers retired from this file, and the commit each was last deployed from:
  //
  //   keeper-sepolia  v2-rc2 0x00f72ee2…3c5a4177  a4f5b62
  "name": "keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs and Traces. Every run emits one structured JSON line — the same
  // report the Telegram alert is rendered from — at the level matching its
  // status: log / warn / error. Traces capture the RPC and Telegram fetches
  // each run makes. Both sample everything: at most one run every ten minutes, volume is
  // not a concern.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },

  // Subrequests per invocation: every RPC call and Telegram message is one, and a
  // run polls for each receipt. Set explicitly because a version keeps the limit
  // it was uploaded under — versions uploaded on Workers Free stay at 50. The
  // Workers Paid default and our setting are both 10,000. Inherited by every env.
  "limits": { "subrequests": 10000 },

  // `secrets` is not inherited, so this top-level copy only guards the root: a
  // bare `wrangler deploy` with no `--env` fails on missing secrets instead of
  // quietly creating a cron-less `keeper` Worker.
  "secrets": {
    "required": ["PRIVATE_KEY", "RPC_URL", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"]
  },

  // Per env. `vars` and `secrets` are not inherited, hence the repetition.
  //
  // Secrets are per deployment and never shared: each env has its own keeper
  // wallet and its own RPC credentials, set once with
  // `wrangler secret put <NAME> --env <env>`. Declaring them in
  // `secrets.required` makes `wrangler deploy` fail while any is unset, rather
  // than deploy a Worker whose every scheduled run can only fail.
  //
  // Cycle limits keep a whole run inside one cron interval, so two runs never
  // share a wallet at once (docs/KEEPERS.md: prevent overlapping invocations).
  // test/config.test.ts holds each env to that:
  //   probe (5 s) + CYCLE_TIMEOUT_MS + RECEIPT_TIMEOUT_MS + 5 s slack ≤ interval
  // and also ≤ the 15 min Cron Trigger wall-clock limit.
  "env": {
    // Sepolia — registry v2-rc3, graceBlocks = 300 (~1 h at 12 s blocks). Every
    // ten minutes leaves ~50 min of slack for missed runs. A run starts new
    // transactions for up to 7 min (CYCLE_TIMEOUT_MS), roughly 35 volumes at
    // 12 s blocks, capped at 30. Each receipt gets up to 2 min: about 1 in 15
    // Sepolia transactions takes 3–5 blocks to land, longer than the old 30 s.
    // Warnings go to Telegram so skipped top-ups, retirements and RPC failovers
    // cannot make a run look healthy.
    "sepolia-v2-rc3": {
      "name": "keeper-cloudflare-sepolia-v2-rc3",
      "vars": {
        "DEPLOYMENT_NAME": "keeper-cloudflare-sepolia-v2-rc3",
        "CHAIN_ID": "11155111",
        "REGISTRY_ADDRESS": "0xab326d6dbdcd1e90e06af22f4e72fa480078745e",
        "NOTIFY_WARNINGS": "true",
        "MIN_BALANCE_WEI": "50000000000000000",
        "MAX_VOLUMES_PER_CYCLE": "30",
        "CYCLE_TIMEOUT_MS": "420000",
        "RECEIPT_TIMEOUT_MS": "120000",
        "CONFIRMATIONS": "1"
      },
      "secrets": {
        "required": ["PRIVATE_KEY", "RPC_URL", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID"]
      },
      "triggers": { "crons": ["*/10 * * * *"] }
    }
  }
}
